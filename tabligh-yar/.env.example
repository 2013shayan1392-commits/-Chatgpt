NODE_ENV=production
PORT=3000
# Set this to the final HTTPS URL after creating the hosting service.
APP_ORIGIN=https://your-miniapp-domain.example
DATABASE_URL=postgresql://username:password@localhost:5432/tabligh_yar
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
EITAA_BOT_TOKEN=your-eitaa-bot-token
ADMIN_USERNAME=admin
ADMIN_PASSWORD=use-a-unique-long-password
# Supabase project URL and service_role key; keep the key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=receipts
# Local browser testing only; keep false in production
DEV_ALLOW_TEST_USER=false