<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.huawei.smartkey.permission.VOICE_RECORDER" />
    <queries>
        <package android:name="com.huawei.phone.recorder" />
        <package android:name="com.android.incallui" />
        <package android:name="com.android.phone" />
        <package android:name="com.shayan.huaweiprobe" />
        <intent>
            <action android:name="com.android.phone.action.voiceRecoderService" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:label="آزمایش سازگاری ضبط هواوی"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
